{
  "name": "diploma-tracker-frontend-monorepo",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "create:app": "turbo generate workspace --type app",
    "create:package": "turbo generate workspace --type package",
    "lint:check": "turbo run lint:check",
    "lint": "turbo run lint",
    "format:check": "pnpm run format:check:root && turbo run format:check",
    "format": "pnpm run format:root && turbo run format",
    "format:check:root": "prettier --check \"./*.{js,cjs,mjs,json,md,yaml,yml}\" \"./.*.{js,cjs,mjs,json,yaml,yml}\" --ignore-unknown",
    "format:root": "prettier --write \"./*.{js,cjs,mjs,json,md,yaml,yml}\" \"./.*.{js,cjs,mjs,json,yaml,yml}\" --ignore-unknown",
    "check-types": "turbo run check-types",
    "generate": "turbo run generate && turbo run format --filter=@repo/api",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.3.1",
    "@commitlint/config-conventional": "^20.3.1",
    "@trivago/prettier-plugin-sort-imports": "^6.0.1",
    "branch-name-lint": "^3.0.1",
    "eslint": "^9.39.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.7.4",
    "prettier-plugin-tailwindcss": "^0.7.1",
    "turbo": "^2.7.2"
  },
  "packageManager": "pnpm@10.19.0",
  "engines": {
    "node": ">=18"
  }
}
