{
  "name": "@repo/utils",
  "description": "Shared utility functions for the monorepo",
  "version": "0.0.0",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./duration": "./src/duration.ts"
  },
  "scripts": {
    "build": "tsc",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/ --fix --max-warnings 0",
    "lint:check": "eslint src/ --max-warnings 0",
    "format": "prettier --write src/ --ignore-unknown",
    "format:check": "prettier --check src/ --ignore-unknown",
    "check-types": "tsc --noEmit",
    "check-types:test": "tsc --noEmit -p tsconfig.test.json"
  },
  "devDependencies": {
    "@repo/code-tools-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^24.10.1",
    "eslint": "^9.39.1",
    "prettier": "^3.7.4",
    "typescript": "~6.0.3",
    "vitest": "^5.0.2"
  },
  "dependencies": {
    "tinyduration": "^3.4.1"
  }
}
