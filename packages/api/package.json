{
  "name": "@repo/api",
  "description": "Shared API for monorepo",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "generate": "dotenv -e .env -- node generate.mjs",
    "format": "prettier --write . --ignore-unknown",
    "format:check": "prettier --check . --ignore-unknown"
  },
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/types/index.ts",
    "./model": "./src/generated/model/index.ts",
    "./auth": "./src/generated/auth.ts",
    "./iam": "./src/generated/iam.ts",
    "./allocation-round": "./src/generated/allocation-round.ts",
    "./supervision-application": "./src/generated/supervision-application.ts",
    "./thesis-defense-session": "./src/generated/thesis-defense-session.ts",
    "./bachelor-thesis-process": "./src/sdk/bachelor-thesis-process.ts",
    "./bachelor-thesis": "./src/generated/bachelor-thesis.ts"
  },
  "devDependencies": {
    "@repo/code-tools-config": "workspace:*",
    "@types/lodash": "^4.17.24",
    "dotenv-cli": "^8.0.0",
    "orval": "^8.8.1",
    "prettier": "^3.7.4"
  },
  "dependencies": {
    "axios": "^1.15.1",
    "lodash": "^4.18.1"
  }
}
